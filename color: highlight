                padding: const EdgeInsets.fromLTRB(16, 12, 16, 12),
                child: Row(
                  children: <Widget>[
                    Expanded(
                      child: FilledButton.tonalIcon(
                        onPressed: settled ? null : _openPaymentSheet,
                        style: FilledButton.styleFrom(
                          backgroundColor: settled
                            ? scheme.surfaceContainerHighest
